{
  "name": "serbisyo-toledo-backend",
  "version": "1.0.0",
  "description": "Backend API for SerbisyoToledo - Local services platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:canonical-integration": "set CANONICAL_INTEGRATION_TEST=1&& vitest run test/canonicalMySql.integration.test.js",
    "seed:admin": "node config/seed-admin.js",
    "migrate:cloudinary": "node config/migrate-images-to-cloudinary.js",
    "email:test": "node scripts/test-email.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:file": "node scripts/run-sql-file.js",
    "db:phase-a": "node scripts/run-sql-file.js migrations/20260807_002_canonical_phase_a_add_backfill.sql",
    "db:phase-b": "node scripts/run-sql-file.js migrations/20260807_003_canonical_phase_b_indexes_resync.sql",
    "db:phase-c": "node scripts/run-sql-file.js migrations/20260807_004_canonical_phase_c_drop_legacy.sql",
    "taxonomy:backfill": "node scripts/backfill-service-taxonomy.js"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^8.0.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
