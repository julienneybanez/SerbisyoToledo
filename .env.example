# Frontend
VITE_API_URL=http://localhost:5000/api

# Backend
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d

# Public frontend address used in backend email links
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=serbisyo_toledo
DB_SSL=false
DATABASE_URL=
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Email provider: mailjet or smtp
EMAIL_PROVIDER=mailjet

# Mailjet HTTPS API
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=toledoserbisyo@gmail.com
MAILJET_SENDER_NAME=SerbisyoToledo
MAILJET_REPLY_TO_EMAIL=toledoserbisyo@gmail.com

# Email controls
# Email verification is mandatory for all public client/service-provider registrations.
WELCOME_EMAIL_ENABLED=false

# SMTP fallback (temporary rollback provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SerbisyoToledo

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# AI assistant preparation
# Keep disabled until an AI provider/model is intentionally configured.
AI_PROVIDER=disabled
